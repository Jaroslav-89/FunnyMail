rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function chatPath(chatId) {
      return /databases/$(database)/documents/chats/$(chatId);
    }

    function invitePath(code) {
      return /databases/$(database)/documents/chatInvites/$(code);
    }

    function isChatMember(chatId) {
      return signedIn()
        && exists(chatPath(chatId))
        && request.auth.uid in get(chatPath(chatId)).data.memberIds;
    }

    function chatCreatorId(chatId) {
      let chat = get(chatPath(chatId)).data;
      return ('creatorUserId' in chat && chat.creatorUserId != '')
        ? chat.creatorUserId
        : chat.memberIds[0];
    }

    function isChatCreator(chatId) {
      return isChatMember(chatId)
        && request.auth.uid == chatCreatorId(chatId);
    }

    function hasValidInviteForChat(chatId) {
      let path = invitePath(request.resource.data.lastInviteCode);
      return request.resource.data.lastInviteCode is string
        && request.resource.data.lastInviteCode.size() > 0
        && exists(path)
        && get(path).data.chatId == chatId
        && get(path).data.createdByUserId in resource.data.memberIds
        && request.time < get(path).data.createdAt + duration.value(7, 'd');
    }

    function hasOneAddedPublicMember() {
      let addedMembers = request.resource.data.memberIds.removeAll(resource.data.memberIds);
      return addedMembers.size() == 1
        && exists(/databases/$(database)/documents/publicProfiles/$(addedMembers[0]));
    }

    function hasOneRemovedMember() {
      let removedMembers = resource.data.memberIds.removeAll(request.resource.data.memberIds);
      return removedMembers.size() == 1;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'memberIds', 'creatorUserId', 'createdAt', 'updatedAt', 'lastInviteCode', 'lastMessageAt', 'maxLettersCount'
        ])
        && (
          !('lastMessageAt' in request.resource.data.keys())
          || request.resource.data.lastMessageAt == null
        )
        && (
          !('creatorUserId' in request.resource.data.keys())
          || request.resource.data.creatorUserId == request.auth.uid
        )
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && (!('description' in request.resource.data.keys())
          || (request.resource.data.description is string && request.resource.data.description.size() <= 120))
        && (!('maxLettersCount' in request.resource.data.keys())
          || request.resource.data.maxLettersCount == null
          || (request.resource.data.maxLettersCount is int
            && request.resource.data.maxLettersCount >= 1
            && request.resource.data.maxLettersCount <= 500))
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 1
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastInviteCode == '';

      // Joining is permitted only as a single-member addition through an unexpired invite.
      // arrayUnion prevents overwriting concurrent membership changes.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberIds', 'updatedAt', 'lastInviteCode'])
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds[0] == resource.data.memberIds[0]
        && request.auth.uid in request.resource.data.memberIds
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.updatedAt == request.time
        && hasValidInviteForChat(chatId);

      // Existing members may directly add one registered user to this chat.
      allow update: if isChatMember(chatId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds[0] == resource.data.memberIds[0]
        && hasOneAddedPublicMember()
        && request.auth.uid in resource.data.memberIds
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.updatedAt == request.time;

      // Only the creator can rename a chat.
      allow update: if isChatCreator(chatId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.updatedAt == request.time;

      // Only the creator can edit the optional chat description.
      allow update: if isChatCreator(chatId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description', 'updatedAt'])
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 120
        && request.resource.data.updatedAt == request.time;

      // Only the creator controls the optional drawing-retention limit.
      allow update: if isChatCreator(chatId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['maxLettersCount', 'updatedAt'])
        && (
          request.resource.data.maxLettersCount == null
          || (request.resource.data.maxLettersCount is int
            && request.resource.data.maxLettersCount >= 1
            && request.resource.data.maxLettersCount <= 500)
        )
        && request.resource.data.updatedAt == request.time;

      // The creator can remove exactly one non-creator member.
      allow update: if isChatCreator(chatId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
        && resource.data.memberIds.hasAll(request.resource.data.memberIds)
        && resource.data.memberIds.size() == request.resource.data.memberIds.size() + 1
        && request.resource.data.memberIds[0] == resource.data.memberIds[0]
        && hasOneRemovedMember()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.updatedAt == request.time;

      // An invited member can leave by removing only their own membership.
      allow update: if isChatMember(chatId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
        && resource.data.memberIds.hasAll(request.resource.data.memberIds)
        && resource.data.memberIds.size() == request.resource.data.memberIds.size() + 1
        && request.resource.data.memberIds[0] == resource.data.memberIds[0]
        && hasOneRemovedMember()
        && request.auth.uid in resource.data.memberIds
        && !(request.auth.uid in request.resource.data.memberIds)
        && chatCreatorId(chatId) in request.resource.data.memberIds
        && request.resource.data.updatedAt == request.time;

      // A member can update only the last-letter timestamp, and only to server request.time.
      allow update: if isChatMember(chatId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt'])
        && request.resource.data.lastMessageAt == request.time;

      allow delete: if isChatCreator(chatId);
    }

    match /chats/{chatId}/letters/{letterId} {
      // Drawing data is stored as JSON text, not as an image or Cloud Storage object.
      // The client supplies expiresAt, but the server request time constrains it to a
      // five-minute window around seven days after this write.
      allow create: if isChatMember(chatId)
        && request.resource.data.keys().hasOnly([
          'authorUserId', 'drawingJson', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.authorUserId == request.auth.uid
        && request.resource.data.drawingJson is string
        && request.resource.data.drawingJson.size() > 0
        && request.resource.data.drawingJson.size() <= 256000
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt
          >= request.time + duration.value(6, 'd') + duration.value(23, 'h') + duration.value(55, 'm')
        && request.resource.data.expiresAt
          <= request.time + duration.value(7, 'd') + duration.value(5, 'm');

      // A single-document read is checked against the server clock.
      allow get: if isChatMember(chatId)
        && resource.data.expiresAt is timestamp
        && request.time < resource.data.expiresAt;

      // Queries cannot reliably prove a server-time comparison against each result.
      // Restrict list access to chat members; the app's query filters expiresAt,
      // and the configured Firestore TTL policy removes expired documents asynchronously.
      allow list: if isChatMember(chatId);
      allow update: if false;
      allow delete: if isChatCreator(chatId)
        || (isChatMember(chatId) && resource.data.authorUserId == request.auth.uid);
    }

    // A member may request server-side pruning when a configured drawing limit is exceeded.
    match /chats/{chatId}/cleanupRequests/{requestId} {
      allow get, list: if false;
      allow create: if isChatMember(chatId)
        && request.resource.data.keys().hasOnly(['requestedByUserId', 'requestedAt'])
        && request.resource.data.requestedByUserId == request.auth.uid
        && request.resource.data.requestedAt == request.time;
      allow update, delete: if false;
    }

    // Each participant can read and maintain only their own per-chat read marker.
    match /chats/{chatId}/reads/{userId} {
      allow get: if isChatMember(chatId) && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if isChatMember(chatId)
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time;
      allow delete: if false;
    }

    // Private user data can only be read by its owner.
    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function publicProfilePath(userId) {
      return /databases/$(database)/documents/publicProfiles/$(userId);
    }

    function usernamePath(username) {
      return /databases/$(database)/documents/usernames/$(username);
    }

    function emailLookupPath(email) {
      return /databases/$(database)/documents/emailLookup/$(email);
    }

    function validUsernameReservation(userId, username) {
      return username == ''
        || (
          existsAfter(usernamePath(username))
          && getAfter(usernamePath(username)).data.userId == userId
        );
    }

    function validEmailReservation(userId, email) {
      return email == ''
        || (
          existsAfter(emailLookupPath(email))
          && getAfter(emailLookupPath(email)).data.userId == userId
        );
    }

    function publicProfileMatchesPrivate(userId) {
      let privateProfile = getAfter(userPath(userId)).data;
      let publicProfile = getAfter(publicProfilePath(userId)).data;
      return publicProfile.uid == userId
        && publicProfile.customName == privateProfile.customName
        && publicProfile.username == privateProfile.username
        && publicProfile.usernameLower == privateProfile.usernameLower
        && publicProfile.providerDisplayName == privateProfile.providerDisplayName
        && publicProfile.generatedName == privateProfile.generatedName
        && publicProfile.avatarUrl == privateProfile.avatarUrl;
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'emailLower', 'customName', 'username', 'usernameLower',
          'providerDisplayName', 'generatedName', 'avatarUrl'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.emailLower is string
        && request.resource.data.customName is string
        && request.resource.data.customName.size() <= 40
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string
        && request.resource.data.username == request.resource.data.usernameLower
        && request.resource.data.providerDisplayName is string
        && request.resource.data.generatedName is string
        && request.resource.data.avatarUrl is string
        && (
          request.resource.data.emailLower == ''
          || (
            request.auth.token.email is string
            && request.resource.data.emailLower == request.auth.token.email.lower()
          )
        )
        && validUsernameReservation(userId, request.resource.data.usernameLower)
        && validEmailReservation(userId, request.resource.data.emailLower)
        && publicProfileMatchesPrivate(userId);
      allow delete: if false;
    }

    // Device push tokens are private to their owner; Cloud Functions reads them with Admin SDK.
    match /users/{userId}/pushTokens/{tokenId} {
      allow get, list: if false;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['token', 'platform'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.platform is string;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // Public participant names are available by known user ID, but email is deliberately
    // kept out of this document. User and handle collections cannot be listed.
    match /publicProfiles/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'customName', 'username', 'usernameLower',
          'providerDisplayName', 'generatedName', 'avatarUrl'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.customName is string
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string
        && request.resource.data.username == request.resource.data.usernameLower
        && request.resource.data.providerDisplayName is string
        && request.resource.data.generatedName is string
        && request.resource.data.avatarUrl is string
        && validUsernameReservation(userId, request.resource.data.usernameLower)
        && publicProfileMatchesPrivate(userId);
      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['userId'])
        && request.auth.uid == request.resource.data.userId
        && !exists(usernamePath(username))
        && getAfter(userPath(request.auth.uid)).data.usernameLower == username
        && getAfter(publicProfilePath(request.auth.uid)).data.usernameLower == username;
      allow update: if signedIn()
        && username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['userId'])
        && request.auth.uid == resource.data.userId
        && request.auth.uid == request.resource.data.userId
        && getAfter(userPath(request.auth.uid)).data.usernameLower == username
        && getAfter(publicProfilePath(request.auth.uid)).data.usernameLower == username;
      allow delete: if signedIn()
        && request.auth.uid == resource.data.userId
        && getAfter(userPath(request.auth.uid)).data.usernameLower != username
        && getAfter(publicProfilePath(request.auth.uid)).data.usernameLower != username;
    }

    match /emailLookup/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && email.matches('^[^/]+$')
        && request.auth.token.email is string
        && email == request.auth.token.email.lower()
        && request.resource.data.keys().hasOnly(['userId'])
        && request.auth.uid == request.resource.data.userId
        && !exists(emailLookupPath(email))
        && getAfter(userPath(request.auth.uid)).data.emailLower == email;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == resource.data.userId;
    }

    match /chatInvites/{code} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['chatId', 'createdByUserId', 'createdAt'])
        && request.resource.data.createdByUserId == request.auth.uid
        && request.resource.data.chatId is string
        && isChatMember(request.resource.data.chatId)
        && request.resource.data.createdAt == request.time;

      allow get: if signedIn()
        && (
          !exists(invitePath(code))
          || resource.data.createdByUserId == request.auth.uid
          || request.time < resource.data.createdAt + duration.value(7, 'd')
        );
      allow list: if false;
      allow update, delete: if false;
    }
  }
}
