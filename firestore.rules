rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function chatPath(chatId) {
      return /databases/$(database)/documents/chats/$(chatId);
    }

    function invitePath(code) {
      return /databases/$(database)/documents/chatInvites/$(code);
    }

    function isChatMember(chatId) {
      return exists(chatPath(chatId))
        && request.auth.uid in get(chatPath(chatId)).data.memberIds;
    }

    function hasValidInviteForChat(chatId) {
      let path = invitePath(request.resource.data.lastInviteCode);
      return request.resource.data.lastInviteCode is string
        && request.resource.data.lastInviteCode.size() > 0
        && exists(path)
        && get(path).data.chatId == chatId
        && get(path).data.createdByUserId in resource.data.memberIds
        && request.time < get(path).data.createdAt + duration.value(7, 'd');
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'title', 'memberIds', 'createdAt', 'updatedAt', 'lastInviteCode'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 1
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastInviteCode == '';

      // Joining is permitted only as a single-member addition through an unexpired invite.
      // arrayUnion prevents overwriting concurrent membership changes.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberIds', 'updatedAt', 'lastInviteCode'])
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.auth.uid in request.resource.data.memberIds
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.updatedAt == request.time
        && hasValidInviteForChat(chatId);

      allow delete: if false;
    }

    match /chatInvites/{code} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['chatId', 'createdByUserId', 'createdAt'])
        && request.resource.data.createdByUserId == request.auth.uid
        && request.resource.data.chatId is string
        && isChatMember(request.resource.data.chatId)
        && request.resource.data.createdAt == request.time;

      allow get: if signedIn()
        && (
          !exists(invitePath(code))
          || resource.data.createdByUserId == request.auth.uid
          || request.time < resource.data.createdAt + duration.value(7, 'd')
        );
      allow list: if false;
      allow update, delete: if false;
    }
  }
}
