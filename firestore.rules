rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function chatPath(chatId) {
      return /databases/$(database)/documents/chats/$(chatId);
    }

    function invitePath(code) {
      return /databases/$(database)/documents/chatInvites/$(code);
    }

    function isChatMember(chatId) {
      return signedIn()
        && exists(chatPath(chatId))
        && request.auth.uid in get(chatPath(chatId)).data.memberIds;
    }

    function chatCreatorId(chatId) {
      let chat = get(chatPath(chatId)).data;
      return ('creatorUserId' in chat) ? chat.creatorUserId : chat.memberIds[0];
    }

    function isChatCreator(chatId) {
      return isChatMember(chatId)
        && request.auth.uid == chatCreatorId(chatId);
    }

    function hasValidInviteForChat(chatId) {
      let path = invitePath(request.resource.data.lastInviteCode);
      return request.resource.data.lastInviteCode is string
        && request.resource.data.lastInviteCode.size() > 0
        && exists(path)
        && get(path).data.chatId == chatId
        && get(path).data.createdByUserId in resource.data.memberIds
        && request.time < get(path).data.createdAt + duration.value(7, 'd');
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'title', 'memberIds', 'creatorUserId', 'createdAt', 'updatedAt', 'lastInviteCode', 'lastMessageAt'
        ])
        && (
          !('lastMessageAt' in request.resource.data.keys())
          || request.resource.data.lastMessageAt == null
        )
        && (
          !('creatorUserId' in request.resource.data.keys())
          || request.resource.data.creatorUserId == request.auth.uid
        )
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 1
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastInviteCode == '';

      // Joining is permitted only as a single-member addition through an unexpired invite.
      // arrayUnion prevents overwriting concurrent membership changes.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberIds', 'updatedAt', 'lastInviteCode'])
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.auth.uid in request.resource.data.memberIds
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.updatedAt == request.time
        && hasValidInviteForChat(chatId);

      // Existing members may directly add one registered user to this chat.
      allow update: if isChatMember(chatId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.auth.uid in resource.data.memberIds
        && request.auth.uid in request.resource.data.memberIds
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.memberIds[resource.data.memberIds.size()]))
        && request.resource.data.updatedAt == request.time;

      // Only the creator can rename a chat.
      allow update: if isChatCreator(chatId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.updatedAt == request.time;

      // The creator can remove exactly one non-creator member.
      allow update: if isChatCreator(chatId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
        && resource.data.memberIds.hasAll(request.resource.data.memberIds)
        && resource.data.memberIds.size() == request.resource.data.memberIds.size() + 1
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.updatedAt == request.time;

      // An invited member can leave by removing only their own membership.
      allow update: if isChatMember(chatId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
        && resource.data.memberIds.hasAll(request.resource.data.memberIds)
        && resource.data.memberIds.size() == request.resource.data.memberIds.size() + 1
        && request.auth.uid in resource.data.memberIds
        && !(request.auth.uid in request.resource.data.memberIds)
        && chatCreatorId(chatId) in request.resource.data.memberIds
        && request.resource.data.updatedAt == request.time;

      // A member can update only the last-letter timestamp, and only to server request.time.
      allow update: if isChatMember(chatId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt'])
        && request.resource.data.lastMessageAt == request.time;

      allow delete: if isChatCreator(chatId);
    }

    match /chats/{chatId}/letters/{letterId} {
      // Drawing data is stored as JSON text, not as an image or Cloud Storage object.
      // The client supplies expiresAt, but the server request time constrains it to a
      // five-minute window around seven days after this write.
      allow create: if isChatMember(chatId)
        && request.resource.data.keys().hasOnly([
          'authorUserId', 'drawingJson', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.authorUserId == request.auth.uid
        && request.resource.data.drawingJson is string
        && request.resource.data.drawingJson.size() > 0
        && request.resource.data.drawingJson.size() <= 262144
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt
          >= request.time + duration.value(6, 'd') + duration.value(23, 'h') + duration.value(55, 'm')
        && request.resource.data.expiresAt
          <= request.time + duration.value(7, 'd') + duration.value(5, 'm');

      // A single-document read is checked against the server clock.
      allow get: if isChatMember(chatId)
        && resource.data.expiresAt is timestamp
        && request.time < resource.data.expiresAt;

      // Queries cannot reliably prove a server-time comparison against each result.
      // Restrict list access to chat members; the app's query filters expiresAt,
      // and the configured Firestore TTL policy removes expired documents asynchronously.
      allow list: if isChatMember(chatId);
      allow update: if false;
      allow delete: if isChatCreator(chatId);
    }

    // Private profile information and email indexes are never listable by clients.
    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.emailLower is string
        && request.resource.data.usernameLower is string;
      allow delete: if false;
    }

    // The directory exposes individual profiles only when the caller already knows a user ID.
    match /publicProfiles/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId;
      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.userId
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if signedIn()
        && request.auth.uid == resource.data.userId
        && request.auth.uid == request.resource.data.userId;
      allow delete: if signedIn() && request.auth.uid == resource.data.userId;
    }

    match /emailLookup/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.userId
        && !exists(/databases/$(database)/documents/emailLookup/$(email));
      allow update: if signedIn()
        && request.auth.uid == resource.data.userId
        && request.auth.uid == request.resource.data.userId;
      allow delete: if signedIn() && request.auth.uid == resource.data.userId;
    }

    match /chatInvites/{code} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['chatId', 'createdByUserId', 'createdAt'])
        && request.resource.data.createdByUserId == request.auth.uid
        && request.resource.data.chatId is string
        && isChatMember(request.resource.data.chatId)
        && request.resource.data.createdAt == request.time;

      allow get: if signedIn()
        && (
          !exists(invitePath(code))
          || resource.data.createdByUserId == request.auth.uid
          || request.time < resource.data.createdAt + duration.value(7, 'd')
        );
      allow list: if false;
      allow update, delete: if false;
    }
  }
}
